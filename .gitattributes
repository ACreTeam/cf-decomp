# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf

# Keep this source in Windows Shift-JIS (CP932) in the working tree.
# Git stores UTF-8 internally for readable diffs.
src/dol/game/d_sv_mgr.cpp text working-tree-encoding=CP932
